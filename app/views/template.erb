<%# Layout for every inner page: the 2005 profile-frame chrome (no doctype: quirks mode, like the capture),
    an 800px white body (content area 760px between 20px gutters) and the profile footer. %><html><head><meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>MySpace.com</title>
<meta name="viewport" content="width=820">
<link rel="icon" href="/images/favicon.ico" type="image/x-icon">
<link rel="STYLESHEET" type="text/css" href="/stylesheets/2005/myspace.css">
</head><body bgcolor="e5e5e5" alink="4e607b" link="4e607b" vlink="4e607b" bottommargin="0" leftmargin="0" rightmargin="0" topmargin="0">

<%= erb :'partials/header' %>

	<table width="800" border="0" cellspacing="0" cellpadding="0" align="center">
		<tr>
			<td width="20" bgcolor="FFFFFF"><img src="/images/2005/clear.gif" width="20" height="2" border="0"></td>
			<td width="760" align="left" valign="top" bgcolor="FFFFFF" class="text"><br>

<%= yield %>

			<br><br></td>
			<td width="20" bgcolor="FFFFFF"><img src="/images/2005/clear.gif" width="20" height="2" border="0"></td>
		</tr>
	</table>

	<img src="/images/2005/clear.gif" width="1" height="1">

<%= erb :'partials/footer' %>

<script type="text/javascript">
	// Mail "select all" checkbox (was jQuery; kept dependency-free).
	(function () {
		var all = document.getElementById("selectAll");
		if (!all) return;
		all.onclick = function () {
			var boxes = document.querySelectorAll('input[type="checkbox"]');
			for (var i = 0; i < boxes.length; i++) if (boxes[i] !== all) boxes[i].checked = all.checked;
		};
	})();
</script>
</body></html>
