<%# Homepage "Cool New People": the newest members, name above a 90px-wide photo (frontpage.css #new dl). %>
<% @users.each_with_index do |user, i| %>
<% n = i + 1 %>
<% pic = user.images.first %>
						<dl>
							<dt><a href="/users/<%= user.id_or_slug %>" id="coolNewPersonURLa<%= n %>"><span id="coolNewPersonName<%= n %>"><%= user.name %></span></a></dt>
							<dd><a href="/users/<%= user.id_or_slug %>" id="coolNewPersonURLb<%= n %>"><img width="90" src="<%= pic ? "/images#{pic.image}" : "/images/2005/no_pic.gif" %>" id="coolNewPersonImage<%= n %>" alt="" /></a></dd>
						</dl>
<% end %>
