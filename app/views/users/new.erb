<%# Signup (GET /users/new, failed POST /users), inside home_layout.erb. No capture of the 2005 join
    form survives, so this is built in the 2005 visual language (myspace.css-style 6699cc boxes,
    b1d0f0/d5e8fb label/value cells, red required labels). Field names, hidden inputs and the
    state/city select ids/classes are what UsersController#create and statecity.js rely on. %>
<style type="text/css">
	#signup { padding: 10px; }
	#signup table { font: normal 8pt/normal Verdana, Arial, Helvetica, sans-serif; }
	#signup form { margin: 0; padding: 0; }
	#signup p { margin: 0 0 10px; }
	#signup .whitetext12 { font-size: 9pt; color: #fff; font-weight: bold; }
	#signup .orangetext15 { font-size: 9pt; color: #f60; font-weight: bold; }
	#signup .lightbluetext8 { font-size: 8pt; color: #369; font-weight: bold; }
	#signup .redtext8b { font-size: 8pt; color: #c00; font-weight: bold; }
	#signup .redtext { font-size: 10pt; color: #c00; }
	#signup .blacktext7 { font-size: 7pt; color: #000; }
	#signup .blacktext12 { font-size: 12pt; color: #000; font-weight: bold; }
	#signup .bluearrow { color: #039; font-weight: bold; }
	#signup .redarrow { color: #c00; font-weight: bold; }
	#signup input, #signup select, #signup textarea { font: normal 8pt Verdana, Arial, Helvetica, sans-serif; }
	#signup .field input.wide, #signup .field select { width: 190px; }
	#signup .field textarea { width: 260px; }
</style>
<script src="//ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js"></script>
<script src="//geodata.solutions/includes/statecity.js"></script>
<div id="signup">
<table width="780" border="0" cellspacing="0" cellpadding="0">
	<tr>
		<td width="440" valign="top">

			<p><span class="blacktext12">Join MySpace Here!</span><br />
			Join for free, and view profiles, connect with others, blog, rank music, and much more!</p>

			<table width="440" border="1" bordercolor="6699cc" cellspacing="0" cellpadding="0">
				<tr>
					<td bgcolor="6699cc" height="22">&nbsp;&nbsp;&nbsp;<span class="whitetext12">Member Sign Up</span></td>
				</tr>
				<tr>
					<td>
					<form method="POST" action="/users" enctype="multipart/form-data" id="spacefix">
					<table width="100%" border="0" cellspacing="3" cellpadding="3">
						<% unless @error.to_s.empty? %>
						<tr>
							<td colspan="2"><span class="redtext"><b><%= @error %></b></span></td>
						</tr>
						<% end %>
						<tr>
							<td width="110" align="right" bgcolor="b1d0f0"><span class="redtext8b">Username:</span></td>
							<td bgcolor="d5e8fb" class="field"><input class="wide" type="text" name="username" value="" maxlength="255" /></td>
						</tr>
						<tr>
							<td align="right" bgcolor="b1d0f0"><span class="redtext8b">Full Name:</span></td>
							<td bgcolor="d5e8fb" class="field"><input class="wide" type="text" name="name" value="" maxlength="255" /></td>
						</tr>
						<tr>
							<td align="right" bgcolor="b1d0f0"><span class="redtext8b">Password:</span></td>
							<td bgcolor="d5e8fb" class="field"><input type="password" name="password" maxlength="10" size="15" /><span class="blacktext7">&nbsp;&nbsp;(max 10 characters)</span></td>
						</tr>
						<tr>
							<td align="right" bgcolor="b1d0f0"><span class="redtext8b">State:</span></td>
							<td bgcolor="d5e8fb" class="field"><input type="hidden" name="country" id="countryId" value="US" />
							<input type="hidden" value="United States" name="country" />
							<select name="state" class="states" id="stateId">
								<option value="">Select State</option>
							</select></td>
						</tr>
						<tr>
							<td align="right" bgcolor="b1d0f0"><span class="redtext8b">City:</span></td>
							<td bgcolor="d5e8fb" class="field"><input type="hidden" name="country" id="countryId" value="US" />
							<input type="hidden" value="United States" name="country" />
							<select name="city" class="cities" id="cityId">
								<option value="">Select City</option>
							</select></td>
						</tr>
						<tr>
							<td align="right" bgcolor="b1d0f0"><span class="redtext8b">Gender:</span></td>
							<td bgcolor="d5e8fb"><select name="gender" id="gender">
								<option value="male">Male</option>
								<option value="female">Female</option>
								<option value="non-binary">Non-Binary</option>
							</select></td>
						</tr>
						<tr>
							<td align="right" bgcolor="b1d0f0"><span class="redtext8b">Age:</span></td>
							<td bgcolor="d5e8fb"><input type="number" name="age" style="width: 50px;" /></td>
						</tr>
						<tr>
							<td align="right" bgcolor="b1d0f0"><span class="redtext8b">Profile Picture:</span></td>
							<td bgcolor="d5e8fb"><input type="file" name="file" class="form-control" /></td>
						</tr>
						<tr>
							<td align="right" valign="top" bgcolor="b1d0f0"><span class="lightbluetext8">About Me:</span></td>
							<td bgcolor="d5e8fb" class="field"><textarea name="bio" rows="5" cols="30" placeholder="Tell us about yourself here!"></textarea></td>
						</tr>
						<tr>
							<td align="right" bgcolor="b1d0f0"><span class="lightbluetext8">Motto:</span></td>
							<td bgcolor="d5e8fb" class="field"><input class="wide" type="text" name="motto" /></td>
						</tr>
						<tr>
							<td colspan="2" align="center"><span class="blacktext7">Fields in <span class="redtext8b">red</span> are required. By clicking Sign Up, you agree to the MySpace <a href="#">Terms of Service</a>.</span></td>
						</tr>
						<tr>
							<td colspan="2" align="center"><input type="image" src="/images/2005/button_signup_main.gif" border="0" alt="Sign Up" /></td>
						</tr>
					</table>
					</form>
					</td>
				</tr>
			</table>

		</td>
		<td width="20">&nbsp;</td>
		<td width="320" valign="top">

			<table width="320" border="1" bordercolor="ffcc99" cellspacing="0" cellpadding="0">
				<tr>
					<td bgcolor="ffcc99" height="22">&nbsp;&nbsp;&nbsp;<span class="orangetext15">Why Join MySpace?</span></td>
				</tr>
				<tr>
					<td>
					<table width="100%" border="0" cellspacing="3" cellpadding="3">
						<tr><td valign="top" class="redarrow">&raquo;</td><td>Create a Private Community on MySpace and share photos, journals and interests with your growing network of mutual friends!</td></tr>
						<tr><td valign="top" class="redarrow">&raquo;</td><td>Create a custom profile, upload pictures, and write blogs and comments.</td></tr>
						<tr><td valign="top" class="redarrow">&raquo;</td><td>Send mail and instant messages to your friends.</td></tr>
						<tr><td valign="top" class="redarrow">&raquo;</td><td>See who knows who, or how you are connected.</td></tr>
						<tr><td valign="top" class="redarrow">&raquo;</td><td>It's <b>FREE</b>, and it only takes a second to join!</td></tr>
					</table>
					</td>
				</tr>
			</table>
			<br />
			<table width="320" border="1" bordercolor="6699cc" cellspacing="0" cellpadding="0">
				<tr>
					<td bgcolor="6699cc" height="22">&nbsp;&nbsp;&nbsp;<span class="whitetext12">Already a Member?</span></td>
				</tr>
				<tr>
					<td>
					<table width="100%" border="0" cellspacing="3" cellpadding="3">
						<tr><td>If you already have a MySpace account, <span class="bluearrow">&raquo;</span> <a href="/login">Login here</a></td></tr>
					</table>
					</td>
				</tr>
			</table>

		</td>
	</tr>
</table>
</div>
