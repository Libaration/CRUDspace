<table width="760" border="0" cellspacing="0" cellpadding="0" align="center">
  <tr>
    <td align="left" valign="bottom"><span class="nametext"><%= @user.name %></span></td>
    <td align="right" valign="bottom" class="text"><a href="/users/<%= @user.id_or_slug %>">Back to <%= @user.name %>'s Profile</a></td>
  </tr>
  <tr><td colspan="2"><img src="/images/2005/clear.gif" width="1" height="8" border="0"></td></tr>
</table>
<table border="1" bordercolor="6699cc" cellspacing="0" cellpadding="0" width="760" align="center">
  <tr><td class="text" align="left" valign="middle" bgcolor="6699cc" height="15">&nbsp;&nbsp;&nbsp;<span class="whitetext12">Profile Song</span></td></tr>
  <tr><td>
    <form method='POST' action='/users/<%= @user.id_or_slug %>/profile_song' enctype="multipart/form-data" id="spacefix" style="margin:0">
    <table border="0" cellspacing="3" cellpadding="3" width="100%" bgcolor="ffffff">
      <tr>
        <td colspan="2" align="left" valign="top" bgcolor="ffffff">Upload an MP3 to play on your profile.</td>
      </tr>
      <% if @error %>
      <tr>
        <td colspan="2" align="left" valign="top" bgcolor="ffffff"><span class="redtext8"><b><%= @error %></b></span></td>
      </tr>
      <% end %>
      <% if !@user.song.nil? %>
      <tr>
        <td valign="top" align="left" width="100" bgcolor="b1d0f0"><span class="lightbluetext8">Current Song:</span></td>
        <td valign="top" align="left" bgcolor="d5e8fb" style="word-wrap:break-word"><%= @user.song.profilesong.to_s.gsub("/uploads/", "") %></td>
      </tr>
      <% end %>
      <tr>
        <td valign="middle" align="left" width="100" bgcolor="b1d0f0"><span class="lightbluetext8">Profile Song:</span></td>
        <td valign="middle" align="left" bgcolor="d5e8fb"><input type='file' name='file' class='form-control'></td>
      </tr>
      <tr>
        <td valign="top" align="left" width="100" bgcolor="ffffff">&nbsp;</td>
        <td valign="top" align="left" bgcolor="ffffff"><input type="submit"></td>
      </tr>
    </table>
    </form>
  </td></tr>
</table>
