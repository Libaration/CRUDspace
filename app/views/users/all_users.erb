<table width="760" border="0" cellspacing="0" cellpadding="0" align="center">
  <tr>
    <td align="left" valign="bottom"><span class="nametext">Browse Users</span></td>
    <td align="right" valign="bottom" class="text"><a href="/users/online">Users Online</a></td>
  </tr>
  <tr><td colspan="2"><img src="/images/2005/clear.gif" width="1" height="8" border="0"></td></tr>
</table>
<table border="1" bordercolor="6699cc" cellspacing="0" cellpadding="0" width="760" align="center">
  <tr><td class="text" align="left" valign="middle" bgcolor="6699cc" height="15">&nbsp;&nbsp;&nbsp;<span class="whitetext12">Search MySpace</span></td></tr>
  <tr><td>
    <table border="0" cellspacing="3" cellpadding="3" width="100%" bgcolor="ffffff">
      <tr>
        <td valign="middle" align="left" width="100" bgcolor="b1d0f0"><span class="lightbluetext8"><label for="search">Name:</label></span></td>
        <td valign="middle" align="left" bgcolor="d5e8fb">
          <form action="/users" method="get" class="usersearch" style="margin:0">
            <input type="text" name="search" id="search" size="30" value="<%= Rack::Utils.escape_html(params[:search].to_s) %>">
            <input type="submit" value="Search">
          </form>
        </td>
      </tr>
    </table>
  </td></tr>
</table>
<br>
<table border="1" bordercolor="6699cc" cellspacing="0" cellpadding="0" width="760" align="center">
  <tr><td class="text" align="left" valign="middle" bgcolor="6699cc" height="15">&nbsp;&nbsp;&nbsp;<span class="whitetext12"><%= params[:search].to_s.empty? ? 'Browse Users' : 'Search Results' %></span></td></tr>
  <tr><td>
    <table border="0" cellspacing="0" cellpadding="5" width="100%" bgcolor="ffffff">
      <tr>
        <td colspan="6" align="left" bgcolor="ffffff"><span class="btext"><% if params[:search].to_s.empty? %>Displaying <span class="redbtext"><%= @users.size %></span> <%= @users.size == 1 ? 'user' : 'users' %>.<% else %>Found <span class="redbtext"><%= @users.size %></span> <%= @users.size == 1 ? 'user' : 'users' %> matching "<%= Rack::Utils.escape_html(params[:search].to_s) %>".<% end %></span></td>
      </tr>
    <% if @users.empty? %>
      <tr><td colspan="6" align="center" valign="middle" bgcolor="d5e8fb" height="50"><span class="blacktext10">No users found.</span></td></tr>
    <% end %>
    <% @users.each_slice(6) do |row| %>
      <tr>
      <% row.each do |friend| %>
      <% friend_pic = friend.images.first %>
        <td align="center" valign="top" width="16%" bgcolor="ffffff" style="word-wrap:break-word">
          &nbsp;<a href="/users/<%= friend.id_or_slug %>"><%= friend.name %></a>&nbsp;<br>
          <a href="/users/<%= friend.id_or_slug %>"><img src="<%= friend_pic ? "/images#{friend_pic.image}" : '/images/2005/no_pic.gif' %>" width="90" border="0"></a>
          <% if User.online.include?(friend) %><br><img src="/images/2005/onlinenow.gif" width="80" height="20" border="0" alt="Online Now!"><% end %>
        </td>
      <% end %>
      <% (6 - row.size).times do %><td width="16%" bgcolor="ffffff">&nbsp;</td><% end %>
      </tr>
    <% end %>
    </table>
  </td></tr>
</table>
