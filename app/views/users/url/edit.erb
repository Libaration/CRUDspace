<style>
  table#urltable {
    width: 100%;
    border: 1px solid #6699cc;
    border-collapse: separate;
    border-spacing: 2px;
    text-align: center;
    font: normal 9pt/normal Verdana, Arial, Helvetica, sans-serif;
  }
  table#urltable th {
    padding: 4px 6px;
    background-color: #6699cc;
    color: white;
    font-weight: bold;
    text-align: left;
  }
  table#urltable td {
    padding: 10px;
    background-color: #e9f1fa;
    line-height: 1.4;
  }
  form.urlform {
    margin: 0;
    text-align: center;
  }
  form.urlform input[type=text] {
    font: normal 9pt/normal Verdana, Arial, Helvetica, sans-serif;
  }
  span.error {
    color: red;
  }
</style>
<table id="urltable">
  <tr><th>Pick your MySpace URL</th></tr>
  <tr><td>
    <strong><span style="color: red;">NOTE:</span> You cannot change your MySpace Name once you pick it, so<br>
      make sure you pick something you're willing to live with!<br><br></strong>
    After you enter your MySpace Name, we'll tell you about the Real Name<br>
    feature.<br><br>
    <form class="urlform" action="/users/<%= current_user.id %>/url" method="POST">
      <input type="hidden" name="_method" value="PATCH">
    <strong>Pick your MySpace Name/URL:</strong><br>
    http://www.myspace.com/<input type="text" name="url"><br><br>
    <strong>Confirm your MySpace Name/URL:</strong><br>
    http://www.myspace.com/<input type="text" name="urlconfirm"><br><br>
    <input type="submit">
    <% unless @error.to_s.empty? %><br><br><strong><span class="error"><%= @error %></span></strong><% end %>
    </form>
  </td></tr>
</table>
