<%
  # Profile page, rebuilt 1:1 from the May 15 2005 capture of www.myspace.com/tom (no doctype: quirks mode, like 2005).
  # Shared state for the profile partials:
  @p_id = @user.id_or_slug
  @p_me = logged_in? ? current_user : nil
  p_online_ids = User.online.pluck(:id)
  @p_online = ->(u) { p_online_ids.include?(u.id) }
  @p_photo = ->(u) { img = u.images.first; img && img.image.url ? "/images#{img.image.url}" : "/images/2005/no_pic.gif" }
  p_custom_css = File.join(settings.public_folder, "profile_css", "#{@user.id}_custom_css.css")
%><html><head><meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>www.myspace.com/<%= @user.url.blank? ? "users/#{@user.id}" : @user.url %></title>
<meta name="keywords" content="friends networking sharing photos finding friends blogs journals blogging journaling bands music rate pics join groups forums classifieds online social networking">
<meta name="description" content="Find old friends and meet new friends as you network, share photos, create blogs, and more at MySpace.com">
<meta name="viewport" content="width=820">
<link rel="icon" href="/images/favicon.ico" type="image/x-icon">
<link rel="STYLESHEET" type="text/css" href="/stylesheets/2005/myspace.css">
<style type="text/css">
	/* IE's word-wrap:break-word also let table cells shrink around long words; emulate it so long text can't widen the page. */
	td[style*="word-wrap" i] { overflow-wrap: anywhere !important; }
	/* 2005 served a 170px-wide "medium" profile photo and 90px-wide "small" thumbnails. */
	img.profilePhoto { max-width: 170px; }
	img.profileThumb { max-width: 90px; }
	table.profileComments td[width="260"] img { max-width: 100%; }
</style>
<% if File.size?(p_custom_css) %>
<link rel="stylesheet" type="text/css" href="/profile_css/<%= @user.id %>_custom_css.css">
<% end %>
</head><body bgcolor="e5e5e5" alink="4e607b" link="4e607b" vlink="4e607b" bottommargin="0" leftmargin="0" rightmargin="0" topmargin="0">

<%= erb :'partials/header' %>

	<table width="800" border="0" cellspacing="0" cellpadding="0" align="center">
		<tr>
			<td width="20" bgcolor="FFFFFF"><img src="/images/2005/clear.gif" width="15" height="2" border="0"></td>
			<td width="780" align="center" bgcolor="FFFFFF">
				<table cellspacing="0" cellpadding="0" border="0">
					<tr>
						<td width="275" height="33" align="center" valign="top" bgcolor="FFFFFF"><br>

<%= erb :'partials/bio' %>

<%= erb :'partials/profile_contact' %>

<% if @user.song %><%= erb :'partials/profile_song' %><% end %>

<%= erb :'partials/profile_interests' %>

<%= erb :'partials/profile_details' %>

<%= erb :'partials/profile_schools' %>

<%= erb :'partials/profile_networking' %>

<%= erb :'partials/profile_companies' %>

						</td>
						<td width="15" align="center" valign="top" bgcolor="White"><img height="1" src="/images/2005/clear.gif" width="20" border="0"></td>
						<td width="435" align="center" valign="top" bgcolor="White" class="text">
						<br>

<table bordercolor="000000" height="75" cellspacing="0" cellpadding="0" width="435" border="1">
	<tr><td valign="center" align="middle" width="435" style="word-wrap:break-word"><span class="blacktext12"><%= @user.name %> is in your extended network<br></span></td></tr>
</table><br>

<%= erb :'partials/profile_blog' %>

<%= erb :'partials/about' %>

<%= erb :'partials/friendslist' %>

<%= erb :'partials/comments' %>

						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>

	<img src="/images/2005/clear.gif" width="1" height="1">

<%= erb :'partials/footer' %>

</body></html>
