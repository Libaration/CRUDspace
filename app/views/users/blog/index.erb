<%# All blog entries (GET /users/:id/blog). No 2005 capture of the blog pages exists: built in the
    profile's blue-box style with the real 2005 blog logo (blogLogo.gif). %>
<table width="760" border="0" cellspacing="0" cellpadding="0" align="center">
  <tr>
    <td colspan="3" align="left" class="text"><a href="/users/<%= @user.id_or_slug %>/blog"><img src="/images/2005/blogLogo.gif" width="146" height="44" border="0" alt="MySpace Blog"></a><br><br></td>
  </tr>
  <tr>
    <td width="200" valign="top" align="left"><%= erb :'users/blog/sidebar' %></td>
    <td width="25"><img src="/images/2005/clear.gif" width="25" height="1" border="0" alt=""></td>
    <td width="535" valign="top" align="left">
      <span class="nametext"><%= h @user.name %>'s Blog</span><br><br>
      <% if @entries.empty? %>
        <%= h @user.name %> hasn't written any blog entries yet.
        <% if logged_in? && current_user == @user %><br><br><a href="/users/<%= @user.id_or_slug %>/blog/new">Post your first blog entry</a><% end %>
      <% else %>
        <b>Displaying <span class="redtext"><%= @entries.size %></span> of <span class="redtext"><%= @entries.size %></span> entries</b><br><br>
        <% @entries.each do |entry| %>
          <%= erb :'users/blog/entry', locals: { entry: entry, full: false } %>
        <% end %>
      <% end %>
    </td>
  </tr>
</table>
<br>
