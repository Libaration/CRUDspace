<style>
  table.mailbox {
    width: 100%;
    border: 1px solid #6699cc;
    border-collapse: separate;
    border-spacing: 2px;
    text-align: left;
    font: normal 8pt/normal Verdana, Arial, Helvetica, sans-serif;
  }
  table.mailbox th {
    padding: 4px 6px;
    background-color: #6699cc;
    color: white;
    font-weight: bold;
  }
  table.mailbox th.label {
    width: 70px;
    padding: 5px 6px;
    background-color: #d5e8fb;
    color: black;
    vertical-align: top;
  }
  table.mailbox td {
    padding: 5px 6px;
    background-color: #e9f1fa;
    vertical-align: top;
  }
  table.mailbox td.sender a.name {
    font-weight: bold;
  }
  table.mailbox td.sender img {
    display: block;
    max-width: 90px;
    max-height: 90px;
    margin-top: 3px;
    border: 1px solid #6699cc;
  }
  table.mailbox td.body {
    height: 60px;
    font-size: 9pt;
    line-height: 1.4;
  }

  div.messageactions {
    display: flex;
    align-items: center;
    padding-top: 6px;
    font: bold 8pt/normal Verdana, Arial, Helvetica, sans-serif;
    color: #152e71;
  }
  div.messageactions form {
    margin: 0;
    text-align: left;
  }
  div.messageactions .messagereply:last-child {
    flex: 1;
    text-align: right;
  }
</style>

<table class="mailbox">
  <tr><th colspan="2">Read Mail</th></tr>
  <tr><th class="label">From:</th><td class="sender"><a class="name" href="/users/<%= @message.sender.id_or_slug %>"><%= @message.sender.name %></a><a href="/users/<%= @message.sender.id_or_slug %>"><img src="/images/<%= @message.sender.images.first.image %>"></a></td></tr>
  <tr><th class="label">Date:</th><td><%= @message.created_at.strftime("%A, %d %b %Y %l:%M %p %Z") %></td></tr>
  <tr><th class="label">Subject:</th><td><%= @message.subject %></td></tr>
  <tr><th class="label">Body:</th><td class="body"><%= @message.content %></td></tr>

</table>
<div class="messageactions">
  <div class="messagereply">
  <form method="GET" action="/users/<%= @user.id_or_slug %>/messages/<%= @message.id %>/reply">
    <input type="submit" value="Reply">
  </form>
  </div>
  <div class="messagereply">
    <% unless previous_message.nil? %> <a href="/users/<%=  @user.id_or_slug  %>/messages/<%=  previous_message.id  %>"> << Previous </a><%  end %>
    <% unless next_message.nil? %> <a href="/users/<%=  @user.id_or_slug  %>/messages/<%=  next_message.id  %>"> Next >></a><%  end %>
  </div>
</div>
