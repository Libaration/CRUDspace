<% sender_pic = @message.sender.images.first %>
<table width="760" border="0" cellspacing="0" cellpadding="0" align="center">
  <tr>
    <td align="left" valign="bottom"><span class="nametext">Mail Center</span></td>
    <td align="right" valign="bottom" class="text"><a href="/users/<%= @user.id_or_slug %>/messages">Inbox</a> | <a href="/users/<%= @user.id_or_slug %>/friend_requests">Friend Requests</a></td>
  </tr>
  <tr><td colspan="2"><img src="/images/2005/clear.gif" width="1" height="8" border="0"></td></tr>
</table>
<table border="1" bordercolor="6699cc" cellspacing="0" cellpadding="0" width="760" align="center">
  <tr><td class="text" align="left" valign="middle" bgcolor="6699cc" height="15">&nbsp;&nbsp;&nbsp;<span class="whitetext12">Read Mail</span></td></tr>
  <tr><td>
    <table border="0" cellspacing="3" cellpadding="3" width="100%" bgcolor="ffffff">
      <tr>
        <td valign="top" align="left" width="100" bgcolor="b1d0f0"><span class="lightbluetext8">From:</span></td>
        <td valign="top" align="left" bgcolor="d5e8fb" style="word-wrap:break-word">
          <a href="/users/<%= @message.sender.id_or_slug %>"><%= @message.sender.name %></a><br>
          <a href="/users/<%= @message.sender.id_or_slug %>"><img src="<%= sender_pic ? "/images#{sender_pic.image}" : '/images/2005/no_pic.gif' %>" width="90" border="0"></a>
        </td>
      </tr>
      <tr>
        <td valign="top" align="left" width="100" bgcolor="b1d0f0"><span class="lightbluetext8">Date:</span></td>
        <td valign="top" align="left" bgcolor="d5e8fb"><%= @message.created_at.strftime("%b %d, %Y %I:%M %p") %></td>
      </tr>
      <tr>
        <td valign="top" align="left" width="100" bgcolor="b1d0f0"><span class="lightbluetext8">Subject:</span></td>
        <td valign="top" align="left" bgcolor="d5e8fb" style="word-wrap:break-word"><b><%= @message.subject %></b></td>
      </tr>
      <tr>
        <td valign="top" align="left" width="100" bgcolor="b1d0f0"><span class="lightbluetext8">Body:</span></td>
        <td valign="top" align="left" bgcolor="d5e8fb" height="120" style="word-wrap:break-word"><%= @message.content %></td>
      </tr>
    </table>
  </td></tr>
</table>
<table width="760" border="0" cellspacing="0" cellpadding="0" align="center">
  <tr>
    <td align="left" valign="middle" height="34">
      <form method="GET" action="/users/<%= @user.id_or_slug %>/messages/<%= @message.id %>/reply" style="margin:0">
        <input type="submit" value="Reply">
      </form>
    </td>
    <td align="right" valign="middle" class="text">
      <% unless previous_message.nil? %><a href="/users/<%=  @user.id_or_slug  %>/messages/<%=  previous_message.id  %>">&lt;&lt; Previous</a><% end %>
      <% if !previous_message.nil? && !next_message.nil? %> | <% end %>
      <% unless next_message.nil? %><a href="/users/<%=  @user.id_or_slug  %>/messages/<%=  next_message.id  %>">Next &gt;&gt;</a><% end %>
    </td>
  </tr>
</table>
