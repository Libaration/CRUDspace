<% friend_pic = @friend.images.first %>
<table width="760" border="0" cellspacing="0" cellpadding="0" align="center">
  <tr>
    <td align="left" valign="bottom"><span class="nametext">Mail Center</span></td>
    <td align="right" valign="bottom" class="text"><a href="/users/<%= @user.id_or_slug %>/messages">Inbox</a> | <a href="/users/<%= @user.id_or_slug %>/friend_requests">Friend Requests</a></td>
  </tr>
  <tr><td colspan="2"><img src="/images/2005/clear.gif" width="1" height="8" border="0"></td></tr>
</table>
<form method="POST" action="/users/<%= @user.id_or_slug %>/messages/<%= @friend.id_or_slug %>" style="margin:0">
<table border="1" bordercolor="6699cc" cellspacing="0" cellpadding="0" width="760" align="center">
  <tr><td class="text" align="left" valign="middle" bgcolor="6699cc" height="15">&nbsp;&nbsp;&nbsp;<span class="whitetext12">Compose Mail</span></td></tr>
  <tr><td>
    <table border="0" cellspacing="3" cellpadding="3" width="100%" bgcolor="ffffff">
      <tr>
        <td valign="top" align="left" width="100" bgcolor="b1d0f0"><span class="lightbluetext8">To:</span></td>
        <td valign="top" align="left" bgcolor="d5e8fb" style="word-wrap:break-word">
          <a href="/users/<%= @friend.id_or_slug %>"><%= @friend.name %></a><br>
          <a href="/users/<%= @friend.id_or_slug %>"><img src="<%= friend_pic ? "/images#{friend_pic.image}" : '/images/2005/no_pic.gif' %>" width="90" border="0"></a>
        </td>
      </tr>
      <tr>
        <td valign="middle" align="left" width="100" bgcolor="b1d0f0"><span class="lightbluetext8">Subject:</span></td>
        <td valign="middle" align="left" bgcolor="d5e8fb"><input type="text" name="subject" size="60" value="<%= Rack::Utils.escape_html(@prefill_subject.to_s) %>"></td>
      </tr>
      <tr>
        <td valign="top" align="left" width="100" bgcolor="b1d0f0"><span class="lightbluetext8">Body:</span></td>
        <td valign="top" align="left" bgcolor="d5e8fb"><textarea style="resize: none" name="content" rows="15" cols="90"><%= Rack::Utils.escape_html(@prefill_content.to_s) %></textarea></td>
      </tr>
    </table>
  </td></tr>
</table>
<table width="760" border="0" cellspacing="0" cellpadding="0" align="center">
  <tr>
    <td align="left" valign="middle" height="34">
      <input type="submit" value="Send">
    </td>
  </tr>
</table>
</form>
