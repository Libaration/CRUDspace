<style>
  table.mailbox {
    width: 100%;
    border: 1px solid #6699cc;
    border-collapse: separate;
    border-spacing: 2px;
    text-align: left;
    font: normal 8pt/normal Verdana, Arial, Helvetica, sans-serif;
  }
  table.mailbox th {
    padding: 4px 6px;
    background-color: #6699cc;
    color: white;
    font-weight: bold;
  }
  table.mailbox th.label {
    width: 70px;
    padding: 5px 6px;
    background-color: #d5e8fb;
    color: black;
    vertical-align: top;
  }
  table.mailbox td {
    padding: 5px 6px;
    background-color: #e9f1fa;
    vertical-align: top;
  }
  table.mailbox td.sender a.name {
    font-weight: bold;
  }
  table.mailbox td.sender img {
    display: block;
    max-width: 90px;
    max-height: 90px;
    margin-top: 3px;
    border: 1px solid #6699cc;
  }
  table.mailbox input[type=text], table.mailbox textarea {
    box-sizing: border-box;
    width: 100%;
    font: normal 9pt/normal Verdana, Arial, Helvetica, sans-serif;
  }
  table.mailbox textarea {
    height: auto;
    border: 1px solid #767676;
    word-wrap: break-word;
  }

  div.messageactions {
    padding-top: 6px;
    text-align: left;
  }
</style>
<form method="POST" action="/users/<%= @user.id_or_slug %>/messages?msg_id=<%= @message.id %>">
  <table class="mailbox">
    <tr><th colspan="2">Reply to Mail</th></tr>
    <tr><th class="label">To:</th><td class="sender"><a class="name" href="/users/<%= @message.sender.id_or_slug %>"><%= @message.sender.name %></a><a href="/users/<%= @message.sender.id_or_slug %>"><img src="/images/<%= @message.sender.images.first.image %>"></a></td></tr>
    <tr><th class="label">Subject:</th><td><input type="text" name="subject" value="RE: <%= @message.subject %>"></td></tr>
    <tr><th class="label">Body:</th><td>
      <textarea style="resize: none" name="content" rows="15">&#013;&#013;------------------------------------- Original Message -------------------------------------&#013;From: <%= @message.sender.name %>&#013;Date: <%= @message.created_at.strftime("%A, %d %b %Y %l:%M %p %Z") %>&#013;&#013;&#013;<%=@message.content.gsub('<br />', "\r\n").strip()%></textarea></td></tr>
  </table>
  <div class="messageactions">
    <div class="messagereply">

      <input type="submit" value="Send">
    </div>
  </div>
</form>
