<% @messages ||= [] %>
<table width="760" border="0" cellspacing="0" cellpadding="0" align="center">
  <tr>
    <td align="left" valign="bottom"><span class="nametext">Mail Center</span></td>
    <td align="right" valign="bottom" class="text"><b>Inbox</b> | <a href="/users/<%= @user.id_or_slug %>/friend_requests">Friend Requests</a></td>
  </tr>
  <tr><td colspan="2"><img src="/images/2005/clear.gif" width="1" height="8" border="0"></td></tr>
</table>
<% if !@user.messages.empty? %>
<table border="1" bordercolor="6699cc" cellspacing="0" cellpadding="0" width="760" align="center">
  <tr><td class="text" align="left" valign="middle" bgcolor="6699cc" height="15">&nbsp;&nbsp;&nbsp;<span class="whitetext12">Inbox</span></td></tr>
  <tr><td>
<table class="mailbox" border="0" cellspacing="3" cellpadding="3" width="100%" bgcolor="ffffff">
  <form method="POST" action="/users/<%= @user.id_or_slug %>/messages">
  <tr>
    <td width="20" align="center" valign="middle" bgcolor="b1d0f0"><input type="checkbox" id="selectAll"></td>
    <td width="110" align="left" valign="middle" bgcolor="b1d0f0"><span class="lightbluetext8">Date:</span></td>
    <td width="120" align="center" valign="middle" bgcolor="b1d0f0"><span class="lightbluetext8">From:</span></td>
    <td width="70" align="left" valign="middle" bgcolor="b1d0f0"><span class="lightbluetext8">Status:</span></td>
    <td align="left" valign="middle" bgcolor="b1d0f0"><span class="lightbluetext8">Subject:</span></td>
  </tr>
    <% @messages.each do |message| %>
    <% sender_pic = message.sender.images.first %>
    <tr>
      <td align="center" valign="middle" bgcolor="d5e8fb"><input type="checkbox" name="message_id[id][]" value="<%= message.id %>"></td>
      <td align="left" valign="middle" bgcolor="d5e8fb" nowrap><%= message.created_at.strftime("%b %d, %Y<br>%I:%M %p") %></td>
      <td align="center" valign="middle" bgcolor="d5e8fb" style="word-wrap:break-word">
        <a href="/users/<%= message.sender.id_or_slug %>"><%= message.sender.name %></a><br>
        <a href="/users/<%= message.sender.id_or_slug %>"><img src="<%= sender_pic ? "/images#{sender_pic.image}" : '/images/2005/no_pic.gif' %>" width="90" border="0"></a>
      </td>
      <td align="left" valign="middle" bgcolor="d5e8fb"><% if message.replied == true %>Replied<% elsif message.read == true %>Read<% else %><span class="rbtext">Unread</span><% end %></td>
      <td align="left" valign="middle" bgcolor="d5e8fb" style="word-wrap:break-word"><a <%= message.read == true ? 'class="readmail" ' : '' %>href="/users/<%= @user.id_or_slug %>/messages/<%= message.id %>"><%= message.subject %></a></td>
    </tr>
  <% end %>
</table>
  </td></tr>
</table>
<table width="760" border="0" cellspacing="0" cellpadding="0" align="center">
  <tr>
    <td align="left" valign="middle" height="34">

      <input type="hidden" name="_method" value="PATCH">
      <input type="submit" value="Mark As Read">

    <form method="post" action="/users/<%= @user.id_or_slug %>/messages">
      <input type="hidden" name="_method" value="DELETE">
      <input type="submit" value="Delete Checked">
        </form>
      </form>
    </td>
    <td align="right" valign="middle" class="text">
    <% unless params[:start].to_i - 5 < 0 %>
      <a href="/users/<%=  @user.id_or_slug  %>/messages?start=<%= params[:start].to_i - 5 %>&end=<%= params[:end].to_i - 5 %>">&lt;&lt; Previous</a>
    <% end %>
    <% unless params[:start].to_i + 5 > @messages.count %>
      <% unless params[:start].to_i - 5 < 0 %> | <% end %>
      <a href="/users/<%=  @user.id_or_slug  %>/messages?start=<%= params[:end].to_i %>&end=<%= params[:end].to_i + 5 %>">Next &gt;&gt;</a>
    <% end %>
    </td>
  </tr>
</table>
  <% else %>
<table border="1" bordercolor="6699cc" cellspacing="0" cellpadding="0" width="760" align="center">
  <tr><td class="text" align="left" valign="middle" bgcolor="6699cc" height="15">&nbsp;&nbsp;&nbsp;<span class="whitetext12">Inbox</span></td></tr>
  <tr><td>
    <table border="0" cellspacing="3" cellpadding="3" width="100%" bgcolor="ffffff">
      <tr><td align="center" valign="middle" bgcolor="d5e8fb" height="50"><span class="blacktext10">You don't have any new Messages at this time.</span></td></tr>
      <tr><td align="center" valign="middle" bgcolor="ffffff">View <a href="/users">Members</a> to find someone to chat with!</td></tr>
    </table>
  </td></tr>
</table>
<% end %>
