<style>
  table.mailbox {
    width: 100%;
    border: 1px solid #6699cc;
    border-collapse: separate;
    border-spacing: 2px;
    text-align: left;
    font: normal 8pt/normal Verdana, Arial, Helvetica, sans-serif;
  }
  table.mailbox th {
    padding: 4px 6px;
    background-color: #6699cc;
    color: white;
    font-weight: bold;
    white-space: nowrap;
  }
  table.mailbox td {
    padding: 5px 6px;
    background-color: #e9f1fa;
    vertical-align: middle;
  }
  table.mailbox tr.unread td {
    background-color: #d5e8fb;
  }

  table.mailbox .check {
    width: 16px;
    padding: 3px;
    text-align: center;
  }
  table.mailbox .check input {
    margin: 0;
  }
  table.mailbox .date {
    width: 85px;
    white-space: nowrap;
  }
  table.mailbox .from {
    width: 100px;
    text-align: center;
  }
  table.mailbox td.from a.name {
    font-weight: bold;
  }
  table.mailbox td.from img {
    display: block;
    max-width: 90px;
    max-height: 90px;
    margin: 3px auto 0;
    border: 1px solid #6699cc;
  }
  table.mailbox .status {
    width: 55px;
  }

  table.emptybox td {
    text-align: center;
    padding: 8px;
  }
  table.emptybox td.emptymsg {
    padding: 15px 8px;
    font-size: 10pt;
  }

  div.messageactions {
    display: flex;
    align-items: center;
    padding-top: 6px;
    font: bold 8pt/normal Verdana, Arial, Helvetica, sans-serif;
    color: #152e71;
  }
  div.messageactions .messagereply {
    margin-right: 4px;
  }
  div.messageactions .messagereply:last-child {
    flex: 1;
    margin-right: 0;
    text-align: right;
  }
</style>
<% if !@user.messages.empty? %>
<table class="mailbox">
  <form method="POST" action="/users/<%= @user.id_or_slug %>/messages">
  <tr><th class="check"><input type="checkbox" id="selectAll"></th> <th class="date">Date:</th> <th class="from">From:</th><th class="status">Status:</th><th>Subject:</th></tr>
    <% @messages.each do |message| %>
    <tr class="<%= message.read == true ? 'read' : 'unread' %>">
      <td class="check"><input type="checkbox" name="message_id[id][]" value="<%= message.id %>"></td>
      <td class="date"><%= message.created_at.strftime("%b %e, %Y<br> %l:%M %p") %></td>
      <td class="from">
        <a class="name" href="/users/<%= message.sender.id_or_slug %>"><%= message.sender.name %></a>
        <a href="/users/<%= message.sender.id_or_slug %>"><img src="/images<%= message.sender.images.first.image %>"></a>
      </td>
      <td class="status"><%= message.replied == true ? 'Replied' : (message.read == true ? 'Read' : 'Unread') %></td>
      <td><a href="/users/<%= @user.id_or_slug %>/messages/<%= message.id %>"><b><%= message.subject %></b></a></td>
    </tr>
  <% end %>


</table>

<div class="messageactions">
  <div class="messagereply">

      <input type="hidden" name="_method" value="PATCH">
      <input type="submit" value="Mark As Read">
  </div>
    <div class="messagereply">
    <form method="post" action="/users/<%= @user.id_or_slug %>/messages">
      <input type="hidden" name="_method" value="DELETE">
      <input type="submit" value="Delete Checked">
        </form>
      </form>
    </div>
  <div class="messagereply">
    <% unless params[:start].to_i - 5 < 0 %>
      <a href="/users/<%=  @user.id_or_slug  %>/messages?start=<%= params[:start].to_i - 5 %>&end=<%= params[:end].to_i - 5 %>"> << Previous </a>
    <% end %>
    <% unless params[:start].to_i + 5 > @messages.count %>
    <a href="/users/<%=  @user.id_or_slug  %>/messages?start=<%= params[:end].to_i %>&end=<%= params[:end].to_i + 5 %>">Next >></a>
    <% end %>
  </div>
</div>
  <% else %>
  <table class="mailbox emptybox">
    <tr><th>Messages</th></tr>
    <tr><td class="emptymsg"><b>You don't have any new Messages at this time.</b></td></tr>
    <tr><td>View <a href="/users">Members</a> to find someone to chat with!</td></tr>
  </table>
<% end %>
