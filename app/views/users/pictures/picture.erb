<table width="760" border="0" cellspacing="0" cellpadding="0" align="center">
  <tr>
    <td align="left" valign="bottom"><span class="nametext"><%= @user.name %></span></td>
    <td align="right" valign="bottom" class="text"><a href="/users/<%= @user.id_or_slug %>">Back to <%= @user.name %>'s Profile</a></td>
  </tr>
  <tr><td colspan="2"><img src="/images/2005/clear.gif" width="1" height="8" border="0"></td></tr>
</table>
<table border="1" bordercolor="6699cc" cellspacing="0" cellpadding="0" width="760" align="center">
  <tr><td class="text" align="left" valign="middle" bgcolor="6699cc" height="15">&nbsp;&nbsp;&nbsp;<span class="whitetext12"><%= @user.name %>'s Pictures</span></td></tr>
  <tr><td>
    <table border="0" cellspacing="0" cellpadding="5" width="100%" bgcolor="ffffff">
      <tr>
        <td colspan="4" align="left" bgcolor="ffffff"><span class="btext"><%= @user.name %> has <span class="redbtext"><%= @user.images.size %></span> <%= @user.images.size == 1 ? 'Picture' : 'Pictures' %>.</span></td>
      </tr>
    <% if @user.images.empty? %>
      <tr><td colspan="4" align="center" valign="middle" bgcolor="d5e8fb" height="50"><span class="blacktext10">There are no pictures yet.</span></td></tr>
    <% end %>
    <% @user.images.each_slice(4) do |row| %>
      <tr>
      <% row.each do |image| %>
        <td align="center" valign="top" width="25%" bgcolor="ffffff" style="word-wrap:break-word">
          <a href="/users/<%= @user.id_or_slug %>/pictures/<%= image.id %>"><img src="/images<%= image.image %>" width="170" border="0"></a>
          <% unless image.caption.to_s.strip.empty? %><br><%= image.caption %><% end %>
        </td>
      <% end %>
      <% (4 - row.size).times do %><td width="25%" bgcolor="ffffff">&nbsp;</td><% end %>
      </tr>
    <% end %>
    </table>
  </td></tr>
</table>
<% if logged_in? && @user == current_user %>
<br>
<table border="1" bordercolor="6699cc" cellspacing="0" cellpadding="0" width="760" align="center">
  <tr><td class="text" align="left" valign="middle" bgcolor="6699cc" height="15">&nbsp;&nbsp;&nbsp;<span class="whitetext12">Upload a New Photo</span></td></tr>
  <tr><td>
    <form method='POST' action='/users/<%= current_user.id_or_slug %>/pictures' enctype="multipart/form-data" id="spacefix" class="upload" style="margin:0">
    <table border="0" cellspacing="3" cellpadding="3" width="100%" bgcolor="ffffff">
      <tr>
        <td valign="middle" align="left" width="100" bgcolor="b1d0f0"><span class="lightbluetext8">Caption:</span></td>
        <td valign="middle" align="left" bgcolor="d5e8fb"><input type="text" placeholder="Add a caption for your photo" name="caption" id="caption" size="50"></td>
      </tr>
      <tr>
        <td valign="middle" align="left" width="100" bgcolor="b1d0f0"><span class="lightbluetext8">Photo:</span></td>
        <td valign="middle" align="left" bgcolor="d5e8fb"><input type='file' name='file' class='form-control' id="file"></td>
      </tr>
      <tr>
        <td valign="top" align="left" width="100" bgcolor="ffffff">&nbsp;</td>
        <td valign="top" align="left" bgcolor="ffffff"><input type="submit" value="Upload"></td>
      </tr>
    </table>
    </form>
  </td></tr>
</table>
<% end %>
