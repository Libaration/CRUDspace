<% pic_index = @user.images.to_a.index(@image) %>
<table width="760" border="0" cellspacing="0" cellpadding="0" align="center">
  <tr>
    <td align="left" valign="bottom"><span class="nametext"><%= @user.name %></span></td>
    <td align="right" valign="bottom" class="text"><a href="/users/<%= @user.id_or_slug %>/pictures">Back to <%= @user.name %>'s Pictures</a></td>
  </tr>
  <tr><td colspan="2"><img src="/images/2005/clear.gif" width="1" height="8" border="0"></td></tr>
</table>
<table border="1" bordercolor="6699cc" cellspacing="0" cellpadding="0" width="760" align="center">
  <tr><td class="text" align="left" valign="middle" bgcolor="6699cc" height="15">&nbsp;&nbsp;&nbsp;<span class="whitetext12"><%= @user.name %>'s Pictures<% if pic_index %> (<%= pic_index + 1 %> of <%= @user.images.size %>)<% end %></span></td></tr>
  <tr><td>
    <table border="0" cellspacing="0" cellpadding="10" width="100%" bgcolor="ffffff">
      <tr>
        <td align="center" valign="top" bgcolor="ffffff" style="word-wrap:break-word">
          <img src="/images<%= @image.image %>" border="0" style="max-width:720px">
          <% unless @image.caption.to_s.strip.empty? %><br><br><span class="blacktext10nb"><%= @image.caption %></span><% end %>
        </td>
      </tr>
    </table>
  </td></tr>
</table>
<% if logged_in? && @user == current_user %>
<br>
<table border="1" bordercolor="6699cc" cellspacing="0" cellpadding="0" width="760" align="center">
  <tr><td class="text" align="left" valign="middle" bgcolor="6699cc" height="15">&nbsp;&nbsp;&nbsp;<span class="whitetext12">Photo Options</span></td></tr>
  <tr><td>
    <table border="0" cellspacing="3" cellpadding="3" width="100%" bgcolor="ffffff">
      <tr>
        <td valign="middle" align="left" width="100" bgcolor="b1d0f0"><span class="lightbluetext8">Delete:</span></td>
        <td valign="middle" align="left" bgcolor="d5e8fb">
          <form method='POST' action='/users/<%= current_user.id_or_slug %>/pictures/<%= @image.id %>' style="margin:0">
            <input type="hidden" name="_method" value="DELETE">
            <input type="submit" value="Delete Photo">
          </form>
        </td>
      </tr>
      <tr>
        <td valign="middle" align="left" width="100" bgcolor="b1d0f0"><span class="lightbluetext8"><label for="caption">Caption:</label></span></td>
        <td valign="middle" align="left" bgcolor="d5e8fb">
          <form method='POST' action='/users/<%= current_user.id_or_slug %>/pictures/<%= @image.id %>' style="margin:0">
            <input type="hidden" name="_method" value="PATCH">
            <input type="text" name="caption" id="caption" size="50" value="<%= Rack::Utils.escape_html(@image.caption.to_s) %>">
            <input type="submit" value="Edit Caption">
          </form>
        </td>
      </tr>
    </table>
  </td></tr>
</table>
<% end %>
