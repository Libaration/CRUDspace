<%# Logged-out homepage (GET /login, and failed POST /login), transcribed from the Jun 18 2005
    www.myspace.com capture. Rendered inside home_layout.erb; styled by frontpage.css.
    POST /login re-renders this view without setting @users. %>
<% @users ||= User.order(id: :desc).limit(2) %>
			<div id="container">
				<div id="left">
					<div id="new">
						<h2>Cool New People</h2>
<%= erb :'/partials/coolnewpeople' %>

						<div class="clearing"></div>
					</div>
					<div id="profile">
						<a href="#"><img src="/images/ads/box_225x170.png" width="225" height="170" border="0" alt="Advertisement" /></a>
					</div>
<%= erb :'/partials/home_music' %>
				</div>
				<div id="right">
					<div id="login">
						<h2>Member Login</h2>
						<% unless @error.to_s.empty? %>
						<p class="error"><%= @error %></p>
						<% end %>
						<form action="/login" method="post" name="theForm" id="theForm">
						<table>
							<tr class="loginElement">
								<td class="label"><label for="username">Username:</label></td>
								<td class="input"><input type="text" name="username" id="username" /></td>
							</tr>
							<tr class="loginElement">
								<td class="label"><label for="password">Password:</label></td>
								<td class="input"><input name="password" type="password" id="password" /></td>
							</tr>
							<tr class="remember">
								<td colspan="2"><input type="checkbox" id="checkbox" />
									<label for="checkbox">Remember my E-mail</label></td>
							</tr>
							<tr class="buttons">
								<td colspan="2"><input name="Submit22" type="image" value="LOGIN" src="/images/2005/button_login_main.gif" alt="Login" />
									<a href="/users/new"><img src="/images/2005/button_signup_main.gif" alt="SIGN UP NOW!" border="0" id="singup" /></a></td>
							</tr>
							<tr class="forgot">
								<td colspan="2"><a href="#">Forgot your password?</a></td>
							</tr>
						</table>
						</form>
					</div>
				</div>
				<div>
					<div>
						<form action="/login" method="get">
							<table>
								<tbody>
									<tr>
										<td colspan="2"><div align="center"></div></td>
									</tr>
								</tbody>
							</table>
						</form>
					</div>
					<div id="advertisement"><img src="/images/2005/advertisement.gif" alt="" /><br />
						<a href="#"><img src="/images/ads/mrec_300x300.png" width="300" height="300" border="0" alt="Advertisement" /></a>
					</div>
				</div>
				<div class="clearing"></div>
			</div>
<%= erb :'/partials/home_getstarted' %>
			<div class="clearing"></div>
